{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "node_modules",
    "*.d.ts",
    "*.test.ts",
    "*.tsbuildinfo",
    "pnpm-lock.yaml",
    "coverage",
    ".git"
  ]
}
