{
  "name": "@uaip/contracts",
  "version": "1.0.0",
  "description": "Service contracts and interfaces for Navratna backend",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@uaip/types": "workspace:*",
    "zod": "catalog:"
  },
  "exports": {
    ".": {
      "@uaip/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tool": {
      "@uaip/source": "./src/tool.ts",
      "import": "./dist/tool.js",
      "require": "./dist/tool.js",
      "types": "./dist/tool.d.ts"
    },
    "./orchestration": {
      "@uaip/source": "./src/orchestration.ts",
      "import": "./dist/orchestration.js",
      "require": "./dist/orchestration.js",
      "types": "./dist/orchestration.d.ts"
    },
    "./events": {
      "@uaip/source": "./src/events.ts",
      "import": "./dist/events.js",
      "require": "./dist/events.js",
      "types": "./dist/events.d.ts"
    },
    "./api": {
      "@uaip/source": "./src/api/index.ts",
      "import": "./dist/api/index.js",
      "require": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    }
  },
  "sideEffects": false
}
