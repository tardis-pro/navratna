# Production build config (Cloudflare Pages → navratna.tardis.digital).
# The API lives on a separate origin, so the bundle must carry an absolute base URL.
# Without this, the client falls back to same-origin and every /api/v1 call is
# answered by the Pages SPA fallback (200 + index.html) instead of the backend.
VITE_API_BASE_URL=https://api.navratna.tardis.digital
VITE_SENTRY_DSN=https://a0cf05abbdcd512c9c63d2463ee5e84d@o321328.ingest.us.sentry.io/4511780759863296
VITE_SENTRY_ENABLE=true
VITE_SENTRY_ENVIRONMENT=production
