{
  "name": "@uaip/artifact-service",
  "version": "1.0.0",
  "description": "UAIP Artifact Generation and Management Service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@uaip/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "bun --hot src/index.ts",
    "test": "vitest run",
    "clean": "rimraf dist",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src"
  },
  "dependencies": {
    "@uaip/config": "workspace:*",
    "@uaip/infra": "workspace:*",
    "@uaip/llm-service": "workspace:*",
    "@uaip/middleware": "workspace:*",
    "@uaip/shared-services": "workspace:*",
    "@uaip/types": "workspace:*",
    "@uaip/utils": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "catalog:backend",
    "drizzle-orm": "catalog:backend",
    "helmet": "catalog:backend",
    "qrcode": "catalog:backend",
    "elysia": "catalog:backend",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "catalog:backend",
    "@types/node": "catalog:backend",
    "@types/qrcode": "catalog:backend",
    "nodemon": "catalog:backend",
    "ts-node": "catalog:backend",
    "tsc-alias": "catalog:backend",
    "tsx": "catalog:backend",
    "typescript": "catalog:"
  },
  "keywords": [
    "uaip",
    "artifact",
    "generation",
    "validation",
    "microservice"
  ],
  "author": "UAIP Team",
  "license": "MIT",
  "nx": {
    "tags": [
      "consolidated-into-navratna-core"
    ]
  }
}
