    { "path": "../../../shared/services/tsconfig.json" },
    { "path": "../../../shared/middleware/tsconfig.json" },
    { "path": "../../../shared/config/tsconfig.json" },
    { "path": "../../../shared/infra/tsconfig.json" }
  ]
}
