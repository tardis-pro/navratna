{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
  "references": [
    { "path": "../../../packages/shared-types" },
    { "path": "../../../packages/shared-utils" },
    { "path": "../../../shared/services" },
    { "path": "../../../shared/middleware" },
    { "path": "../../../shared/config" },
    { "path": "../../../shared/infra" }
  ]
}
