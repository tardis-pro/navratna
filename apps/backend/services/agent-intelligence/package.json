{
    "name": "@uaip/agent-intelligence",
    "version": "1.0.0",
    "description": "UAIP Agent Intelligence Engine - Context analysis and decision making",
    "main": "./dist/index.js",
    "type": "module",
    "scripts": {
        "build": "tsc && tsc-alias",
        "dev": "bun --hot src/index.ts",
        "clean": "rimraf dist",
        "lint": "oxlint src",
        "lint:fix": "oxlint --fix src",
        "format": "oxfmt --write src",
        "format:check": "oxfmt --check src",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage",
        "test:ui": "vitest --ui"
    },
    "dependencies": {
        "@tobilu/qmd": "^2.1.0",
        "@uaip/config": "workspace:*",
        "@uaip/infra": "workspace:*",
        "@uaip/llm-service": "workspace:*",
        "@uaip/middleware": "workspace:*",
        "@uaip/shared-services": "workspace:*",
        "@uaip/types": "workspace:*",
        "@uaip/utils": "workspace:*",
        "compression": "catalog:backend",
        "cors": "catalog:backend",
        "dotenv": "catalog:backend",
        "elysia": "catalog:backend",
        "helmet": "catalog:backend",
        "morgan": "^1.10.0",
        "multer": "catalog:backend",
        "node-cron": "^4.1.0",
        "prom-client": "catalog:backend",
        "uuid": "catalog:backend",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/compression": "catalog:backend",
        "@types/cors": "catalog:backend",
        "@types/morgan": "^1.9.10",
        "@types/multer": "catalog:backend",
        "@types/node": "catalog:backend",
        "@types/node-cron": "^3.0.11",
        "@types/uuid": "^10.0.0",
        "concurrently": "catalog:dev",
        "nodemon": "catalog:backend",
        "tsc-alias": "catalog:backend",
        "tsx": "catalog:backend",
        "typescript": "catalog:",
        "vitest": "catalog:dev"
    },
    "nx": {
        "tags": [
            "legacy-service"
        ]
    }
}
