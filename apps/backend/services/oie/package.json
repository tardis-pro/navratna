{
  "name": "@uaip/oie",
  "version": "1.0.0",
  "description": "OIE — Operational Intelligence Engine: modular, provider-agnostic continuous improvement platform",
  "main": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "@uaip/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./feature": {
      "@uaip/source": "./src/feature.ts",
      "types": "./dist/feature.d.ts",
      "import": "./dist/feature.js",
      "default": "./dist/feature.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src"
  },
  "dependencies": {
    "@uaip/config": "workspace:*",
    "@uaip/infra": "workspace:*",
    "@uaip/middleware": "workspace:*",
    "@uaip/shared-services": "workspace:*",
    "@uaip/types": "workspace:*",
    "@uaip/utils": "workspace:*",
    "bullmq": "catalog:backend",
    "ioredis": "catalog:backend",
    "zod": "catalog:",
    "axios": "catalog:backend"
  },
  "devDependencies": {
    "@types/node": "catalog:backend",
    "typescript": "catalog:"
  },
  "nx": {
    "tags": ["backend-service", "oie"]
  }
}
