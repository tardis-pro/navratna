{
  "name": "@uaip/security-gateway",
  "version": "1.0.0",
  "type": "module",
  "description": "UAIP Security Gateway Service - Authentication, Authorization, and Approval Workflows",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "bun --hot src/index.ts",
    "clean": "rimraf dist",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:integration": "vitest run --reporter=verbose src/__tests__/integration",
    "test:integration:oauth": "vitest run src/__tests__/integration/oauth-flow.integration.test.ts",
    "test:integration:security": "vitest run src/__tests__/integration/security-validation.integration.test.ts",
    "test:integration:coverage": "vitest run --coverage src/__tests__/integration"
  },
  "dependencies": {
    "@uaip/config": "workspace:*",
    "@uaip/infra": "workspace:*",
    "@uaip/middleware": "workspace:*",
    "@uaip/shared-services": "workspace:*",
    "@uaip/llm-service": "workspace:*",
    "@uaip/types": "workspace:*",
    "@uaip/utils": "workspace:*",
    "elysia": "catalog:backend",
    "axios": "^1.7.7",
    "base64url": "^3.0.1",
    "bcrypt": "catalog:backend",
    "bcryptjs": "^3.0.2",
    "compression": "catalog:backend",
    "cors": "catalog:backend",
    "helmet": "catalog:backend",
    "jsonwebtoken": "catalog:backend",
    "multer": "catalog:backend",
    "node-cron": "^4.1.0",
    "nodemailer": "^7.0.3",
    "pg": "catalog:backend",
    "prom-client": "catalog:backend",
    "qrcode": "^1.5.3",
    "redis": "^5.5.6",
    "speakeasy": "^2.0.0",
    "winston": "catalog:backend",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcrypt": "catalog:backend",
    "@types/compression": "catalog:backend",
    "@types/cors": "catalog:backend",
    "@types/jsonwebtoken": "catalog:backend",
    "@types/node": "catalog:backend",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "catalog:backend",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.0",
    "concurrently": "catalog:dev",
    "vitest": "catalog:backend",
    "@vitest/coverage-v8": "catalog:backend",
    "nodemon": "catalog:backend",
    "supertest": "^7.1.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "catalog:backend",
    "tsx": "catalog:backend",
    "typescript": "catalog:"
  },
  "keywords": [
    "uaip",
    "security",
    "authentication",
    "authorization",
    "approval-workflows",
    "audit",
    "rbac"
  ],
  "author": "UAIP Team",
  "license": "MIT",
  "nx": {
    "tags": [
      "legacy-service"
    ]
  }
}
