{
  "name": "@uaip/llm-service",
  "version": "1.0.0",
  "description": "Unified LLM service for all UAIP backend services",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src"
  },
  "dependencies": {
    "@tanstack/ai": "^0.0.3",
    "@tanstack/ai-anthropic": "^0.0.3",
    "@tanstack/ai-ollama": "^0.0.3",
    "@tanstack/ai-openai": "^0.0.3",
    "@uaip/config": "workspace:*",
    "@uaip/middleware": "workspace:*",
    "@uaip/shared-services": "workspace:*",
    "@uaip/types": "workspace:*",
    "@uaip/utils": "workspace:*",
    "node-fetch": "^3.3.2",
    "uuid": "catalog:backend"
  },
  "devDependencies": {
    "@types/node": "catalog:backend",
    "@types/uuid": "^10.0.0",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ]
}
