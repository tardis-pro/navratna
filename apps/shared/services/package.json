{
  "name": "@uaip/shared-services",
  "version": "1.0.0",
  "description": "Shared services for UAIP backend",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=unit",
    "test:e2e": "jest --testPathPattern=e2e",
    "seed": "tsx src/database/seeders/index.ts",
    "seed:build": "tsc && node dist/database/seeders/index.js",
    "drizzle:studio": "drizzle-kit studio --config drizzle.config.ts",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:check": "drizzle-kit check --config drizzle.config.ts"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "@uaip/config": "workspace:*",
    "drizzle-orm": "catalog:backend",
    "@uaip/infra": "workspace:*",
    "@uaip/middleware": "workspace:*",
    "@uaip/types": "workspace:*",
    "@uaip/utils": "workspace:*",
    "bcryptjs": "^3.0.3",
    "compression": "catalog:backend",
    "elysia": "catalog:backend",
    "helmet": "catalog:backend",
    "ioredis": "catalog:backend",
    "morgan": "^1.10.0",
    "neo4j-driver": "catalog:backend",
    "pg": "catalog:backend",
    "uuid": "^11.1.0",
    "winston": "catalog:backend",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "drizzle-kit": "catalog:dev",
    "@types/compression": "catalog:backend",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "catalog:backend",
    "@types/pg": "catalog:backend",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "jest-environment-node": "^30.2.0",

    "rimraf": "catalog:",
    "supertest": "^7.0.0",
    "testcontainers": "^11.10.0",
    "ts-jest": "^29.2.5",
    "ts-node": "catalog:",
    "tsc-alias": "catalog:backend",
    "tsx": "catalog:backend",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./drizzle": {
      "import": "./dist/database/drizzle/index.js",
      "require": "./dist/database/drizzle/index.js",
      "types": "./dist/database/drizzle/index.d.ts"
    },
    "./drizzle/intelligence": {
      "import": "./dist/database/drizzle/schemas/intelligence.schema.js",
      "require": "./dist/database/drizzle/schemas/intelligence.schema.js",
      "types": "./dist/database/drizzle/schemas/intelligence.schema.d.ts"
    },
    "./drizzle/control": {
      "import": "./dist/database/drizzle/schemas/control.schema.js",
      "require": "./dist/database/drizzle/schemas/control.schema.js",
      "types": "./dist/database/drizzle/schemas/control.schema.d.ts"
    },
    "./drizzle/clients": {
      "import": "./dist/database/drizzle/clients/index.js",
      "require": "./dist/database/drizzle/clients/index.js",
      "types": "./dist/database/drizzle/clients/index.d.ts"
    },
    "./agentIntelligenceService": {
      "import": "./dist/agentIntelligenceService.js",
      "require": "./dist/agentIntelligenceService.js",
      "types": "./dist/agentIntelligenceService.d.ts"
    },
    "./capabilityDiscoveryService": {
      "import": "./dist/capabilityDiscoveryService.js",
      "require": "./dist/capabilityDiscoveryService.js",
      "types": "./dist/capabilityDiscoveryService.d.ts"
    },
    "./securityValidationService": {
      "import": "./dist/securityValidationService.js",
      "require": "./dist/securityValidationService.js",
      "types": "./dist/securityValidationService.d.ts"
    },
    "./eventBusService": {
      "import": "@uaip/infra/eventBus.js",
      "require": "@uaip/infra/eventBus.js",
      "types": "@uaip/infra/eventBus.d.ts"
    },
    "./databaseService": {
      "import": "@uaip/infra/database/index.js",
      "require": "@uaip/infra/database/index.js",
      "types": "@uaip/infra/database/index.d.ts"
    },
    "./cacheService": {
      "import": "@uaip/infra/cache/index.js",
      "require": "@uaip/infra/cache/index.js",
      "types": "@uaip/infra/cache/index.d.ts"
    },
    "./stateManagerService": {
      "import": "./dist/stateManagerService.js",
      "require": "./dist/stateManagerService.js",
      "types": "./dist/stateManagerService.d.ts"
    },
    "./stepExecutorService": {
      "import": "./dist/stepExecutorService.js",
      "require": "./dist/stepExecutorService.js",
      "types": "./dist/stepExecutorService.d.ts"
    },
    "./resourceManagerService": {
      "import": "./dist/resourceManagerService.js",
      "require": "./dist/resourceManagerService.js",
      "types": "./dist/resourceManagerService.d.ts"
    },
    "./compensationService": {
      "import": "./dist/compensationService.js",
      "require": "./dist/compensationService.js",
      "types": "./dist/compensationService.d.ts"
    },
    "./personaService": {
      "import": "./dist/personaService.js",
      "require": "./dist/personaService.js",
      "types": "./dist/personaService.d.ts"
    },
    "./discussionService": {
      "import": "./dist/discussionService.js",
      "require": "./dist/discussionService.js",
      "types": "./dist/discussionService.d.ts"
    },
    "./drizzleService": {
      "import": "./dist/drizzleService.js",
      "require": "./dist/drizzleService.js",
      "types": "./dist/drizzleService.d.ts"
    }
  }
}
