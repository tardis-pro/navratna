{
  "name": "@uaip/config",
  "version": "1.0.0",
  "description": "Shared configuration for UAIP backend",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src"
  },
  "dependencies": {
    "dotenv": "catalog:backend",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:backend",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "@uaip/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
