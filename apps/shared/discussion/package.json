{
  "name": "@uaip/discussion-core",
  "version": "1.0.0",
  "description": "UAIP Discussion domain services — canonical shared package",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "@uaip/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./feature": {
      "@uaip/source": "./src/feature.ts",
      "types": "./dist/feature.d.ts",
      "import": "./dist/feature.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src"
  },
  "dependencies": {
    "@uaip/config": "workspace:*",
    "@uaip/infra": "workspace:*",
    "@uaip/middleware": "workspace:*",
    "@uaip/shared-services": "workspace:*",
    "@uaip/types": "workspace:*",
    "@uaip/utils": "workspace:*",
    "@hapi/boom": "catalog:backend",
    "@socket.io/bun-engine": "^0.0.2",
    "baileys": "catalog:backend",
    "elysia": "catalog:backend",
    "ioredis": "catalog:backend",
    "socket.io": "catalog:backend",
    "ws": "catalog:backend",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:backend",
    "@types/ws": "catalog:backend",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  }
}
