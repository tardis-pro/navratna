# syntax=docker/dockerfile:1.7
# =============================================================================
# navratna-core — multi-stage build
#
# Fast-deploy design:
#   1. Layer cache is honored (do NOT pass --no-cache when deploying).
#   2. BuildKit cache mounts persist the pnpm store + Nx cache across builds,
#      so `pnpm install` is incremental and `nx build` reuses prior compiles
#      even when a layer is invalidated.
#   3. Multi-stage: the `runtime` image ships only the compiled dist + pruned
#      production node_modules (no dev deps, no source, no toolchain) → smaller
#      image → faster push (--local-only) and faster machine cold-start.
# =============================================================================

# ---------------------------------------------------------------------------
# builder — installs deps and compiles the workspace
# ---------------------------------------------------------------------------
FROM oven/bun:1 AS builder

RUN apt-get update && apt-get install -y curl libatomic1 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://get.pnpm.io/install.sh | PNPM_VERSION=10.12.1 PNPM_HOME=/usr/local/bin ENV="$HOME/.shrc" SHELL="$(which sh)" sh -

# Route the pnpm content-addressable store to a stable path that we mount as a
# BuildKit cache below — keeps it out of image layers and makes installs incremental.
# pnpm reads the store location from the `store-dir` config; expose it via the
# npm_config_* env so both `install` and `prune` honor the cache-mounted path.
ENV PNPM_HOME=/usr/local/bin
ENV npm_config_store_dir=/pnpm-store

WORKDIR /app

COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY package.json ./
COPY tsconfig.json ./
COPY tsconfig.base.json ./
COPY nx.json ./

COPY apps/packages/ ./apps/packages/
COPY apps/shared/   ./apps/shared/

COPY apps/backend/package.json  ./apps/backend/
COPY apps/backend/tsconfig.json ./apps/backend/
COPY apps/backend/services/navratna-core/package.json        ./apps/backend/services/navratna-core/
COPY apps/backend/services/navratna-core/tsconfig.json       ./apps/backend/services/navratna-core/
COPY apps/backend/services/navratna-core/tsconfig.build.json ./apps/backend/services/navratna-core/
COPY apps/backend/services/agent-intelligence/package.json   ./apps/backend/services/agent-intelligence/
COPY apps/backend/services/agent-intelligence/tsconfig.json  ./apps/backend/services/agent-intelligence/
COPY apps/backend/services/agent-intelligence/tsconfig.build.json ./apps/backend/services/agent-intelligence/
COPY apps/backend/services/discussion-orchestration/package.json ./apps/backend/services/discussion-orchestration/
COPY apps/backend/services/discussion-orchestration/tsconfig.json ./apps/backend/services/discussion-orchestration/
COPY apps/backend/services/discussion-orchestration/tsconfig.build.json ./apps/backend/services/discussion-orchestration/
COPY apps/backend/services/artifact-service/package.json     ./apps/backend/services/artifact-service/
COPY apps/backend/services/artifact-service/tsconfig.json    ./apps/backend/services/artifact-service/
COPY apps/backend/services/artifact-service/tsconfig.build.json ./apps/backend/services/artifact-service/
COPY apps/backend/services/llm-service/package.json          ./apps/backend/services/llm-service/
COPY apps/backend/services/llm-service/tsconfig.json         ./apps/backend/services/llm-service/
COPY apps/backend/services/llm-service/tsconfig.build.json   ./apps/backend/services/llm-service/
COPY apps/backend/services/oie/package.json                  ./apps/backend/services/oie/
COPY apps/backend/services/oie/tsconfig.json                 ./apps/backend/services/oie/

# Cache mount: pnpm store persists across builds → incremental installs.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store \
    pnpm install --frozen-lockfile --shamefully-hoist

# Cache mount: Nx cache persists across builds → unchanged projects skip recompile.
RUN --mount=type=cache,id=nx-cache,target=/app/.nx/cache \
    pnpm nx run-many -t build --projects=@uaip/types,@uaip/utils,@uaip/contracts,@uaip/config,@uaip/infra,@uaip/middleware,@uaip/shared-services,@uaip/llm-service

RUN find apps/shared apps/packages -type d -name src -prune -exec sh -c \
      'find "$1" -type f \( -name "*.js" -o -name "*.js.map" -o -name "*.d.ts" -o -name "*.d.ts.map" \) -delete' _ {} \;

COPY apps/backend/services/navratna-core/src/                ./apps/backend/services/navratna-core/src/
COPY apps/backend/services/agent-intelligence/src/           ./apps/backend/services/agent-intelligence/src/
COPY apps/backend/services/discussion-orchestration/src/     ./apps/backend/services/discussion-orchestration/src/
COPY apps/backend/services/artifact-service/src/             ./apps/backend/services/artifact-service/src/
COPY apps/backend/services/llm-service/src/                  ./apps/backend/services/llm-service/src/
COPY apps/backend/services/oie/src/                          ./apps/backend/services/oie/src/

RUN --mount=type=cache,id=nx-cache,target=/app/.nx/cache \
    pnpm nx run-many -t build --projects=@uaip/agent-intelligence,@uaip/discussion-orchestration,@uaip/artifact-service,@uaip/llm-service-api,@uaip/oie,@uaip/navratna-core

RUN CORE_DIST=apps/backend/services/navratna-core/dist && \
    mkdir -p "$CORE_DIST/artifact-service/src" "$CORE_DIST/llm-service/src" && \
    cp -r apps/backend/services/artifact-service/dist/* "$CORE_DIST/artifact-service/src/" && \
    cp -r apps/backend/services/llm-service/dist/*       "$CORE_DIST/llm-service/src/"

# NOTE: `pnpm prune --prod` would shrink the runtime image further, but on a
# --shamefully-hoist workspace it can drop hoisted transitive deps that a
# compiled package resolves at runtime but does not declare — a boot risk in this
# stack (see Elysia AOT / config throw-on-load footguns). Left disabled until
# validated with a smoke test. To enable: uncomment and verify scripts/smoke-test-core.sh.
# RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store \
#     pnpm prune --prod --config.confirmModulesPurge=false

# ---------------------------------------------------------------------------
# runtime — minimal image: dist + prod node_modules only
# ---------------------------------------------------------------------------
FROM oven/bun:1 AS runtime

RUN apt-get update && apt-get install -y libatomic1 && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1001 nodejs && \
    useradd --uid 1001 --gid nodejs --no-create-home uaip

# Create /app owned by uaip BEFORE copying, so the app can write runtime dirs
# (e.g. winston's ./logs) — matches the old single-stage `chown -R uaip /app`.
RUN mkdir -p /app && chown uaip:nodejs /app
WORKDIR /app

# Root workspace node_modules (hoisted) + workspace package linkage.
COPY --from=builder --chown=uaip:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=uaip:nodejs /app/package.json ./package.json
COPY --from=builder --chown=uaip:nodejs /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

# Compiled output for the shared packages the service imports at runtime.
COPY --from=builder --chown=uaip:nodejs /app/apps/packages ./apps/packages
COPY --from=builder --chown=uaip:nodejs /app/apps/shared   ./apps/shared

# Compiled service dist (navratna-core bundles agent-intelligence/discussion/artifact/llm/oie).
COPY --from=builder --chown=uaip:nodejs /app/apps/backend/services/navratna-core/dist \
     ./apps/backend/services/navratna-core/dist
COPY --from=builder --chown=uaip:nodejs /app/apps/backend/services/navratna-core/package.json \
     ./apps/backend/services/navratna-core/package.json

USER uaip

ENV NODE_ENV=production
ENV NAVRATNA_CORE_PORT=8080
EXPOSE 8080

CMD ["bun", "apps/backend/services/navratna-core/dist/navratna-core/src/index.js"]
