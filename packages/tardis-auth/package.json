{
  "name": "@tardis/auth",
  "version": "0.1.0",
  "description": "Auth middleware for TARDIS platform subdomains — validates JWT via JWKS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./elysia": "./dist/elysia.js",
    "./express": "./dist/express.js",
    "./hono": "./dist/hono.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "jose": "^6.0.0"
  },
  "peerDependencies": {
    "elysia": ">=1.0.0",
    "express": ">=4.0.0",
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "elysia": { "optional": true },
    "express": { "optional": true },
    "hono": { "optional": true }
  }
}
