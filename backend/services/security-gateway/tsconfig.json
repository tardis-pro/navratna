{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist", // relative to package root
    "rootDir": "src",
    "baseUrl": ".", // enables clean import paths within the package
    "noImplicitAny": false,
    "noCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "useDefineForClassFields": false,
    "paths": {
      "@/services/*": ["src/services/*"],
      "@/routes/*": ["src/routes/*"],
      "@uaip/types": ["../../../packages/shared-types/src"],
      "@uaip/types/*": ["../../../packages/shared-types/src/*"],
      "@uaip/utils": ["../../../packages/shared-utils/src"],
      "@uaip/utils/*": ["../../../packages/shared-utils/src/*"],
      "@uaip/config": ["../../shared/config/src"],
      "@uaip/config/*": ["../../shared/config/src/*"],
      "@uaip/shared-services": ["../../shared/services/src"],
      "@uaip/shared-services/*": ["../../shared/services/src/*"],
      "@uaip/middleware": ["../../shared/middleware/src"],
      "@uaip/middleware/*": ["../../shared/middleware/src/*"],
      "@uaip/llm-service": ["../../shared/llm-service"],
      "@uaip/llm-service/*": ["../../shared/llm-service/*"],
      "@uaip/infra": ["../../shared/infra/src"],
      "@uaip/infra/*": ["../../shared/infra/src/*"]
    }
  },
  "references": [
    {
      "path": "../../../packages/shared-types"
    },
    {
      "path": "../../../packages/shared-utils"
    },
    {
      "path": "../../shared/config"
    },
    {
      "path": "../../shared/services"
    },
    {
      "path": "../../shared/middleware"
    },
    {
      "path": "../../shared/infra"
    }
  ],
  "files": ["src/routes/llmAgentProviderRoutes.ts"],
  "include": ["src/**/*", "src/__tests__/types/**/*"],
  "exclude": ["src/__tests__/**/*", "!src/__tests__/types/**/*", "src/routes/**/*"]
}
