{
    "files": [],
    "references": [
        { "path": "./apps/frontend" },
        { "path": "./apps/packages/contracts" },
        { "path": "./apps/packages/shared-types" },
        { "path": "./apps/packages/shared-utils" },
        { "path": "./apps/backend" }
    ],
    "compilerOptions": {
        "paths": {
            "@uaip/types": ["./apps/packages/shared-types/src"],
            "@uaip/types/*": ["./apps/packages/shared-types/src/*"],
            "@uaip/contracts": ["./apps/packages/contracts/src"],
            "@uaip/contracts/*": ["./apps/packages/contracts/src/*"],
            "@uaip/utils": ["./apps/packages/shared-utils/src"],
            "@uaip/utils/*": ["./apps/packages/shared-utils/src/*"]
        },
        "types": ["node"],
        "lib": ["es2022"],
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "noImplicitAny": true,
        "noUnusedParameters": false,
        "skipLibCheck": true,
        "allowJs": true,
        "noUnusedLocals": false,
        "strictNullChecks": false
    }
}
