{
  "configVersion": "1.6",
  "$schema": "https://github.com/jayu/rev-dep/blob/master/config-schema/1.6.schema.json?raw=true",
  "rules": [
    {
      "path": ".",
      "moduleBoundaries": [
        {
          "name": "packages",
          "pattern": "apps/packages/**/*",
          "allow": ["apps/packages/**/*"],
        },
      ],
      "orphanFilesDetection": {
        "enabled": false,
      },
      "unusedExportsDetection": {
        "enabled": false,
      },
