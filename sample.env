# =============================================================================
# Navratna - Environment Configuration
# =============================================================================
# This is a comprehensive sample of all available environment variables
# Copy this file to .env and modify values as needed for your environment
# =============================================================================

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development                    # development | production | test
SERVICE_NAME=shared-service            # Override per service
SERVICE_VERSION=1.0.0
PORT=3000                              # Default port, override per service

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
POSTGRES_URL=postgresql://uaip_user:uaip_password@localhost:5432/uaip
# OR configure individually:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=uaip_user
POSTGRES_PASSWORD=uaip_password
POSTGRES_DB=uaip
POSTGRES_MULTIPLE_DATABASES=uaip,uaip_test
DB_SSL=false

# Multi-plane database URLs (see docs/specs/04-INFRASTRUCTURE-TOPOLOGY.md)
# Single-machine (dev): leave unset — both planes fall back to POSTGRES_URL
# Multi-machine: set each to the respective machine's PostgreSQL
# POSTGRES_URL_INTELLIGENCE=postgresql://pc-a-navratna.tailnet:5432/navratna
# POSTGRES_URL_CONTROL=postgresql://pc-b-navratna.tailnet:5432/navratna
DB_MAX_CONNECTIONS=20
DB_TIMEOUT=30000

# Neo4j Graph Database
NEO4J_URL=bolt://neo4j:7687
# OR configure individually:
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=uaip_dev_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTIONS=50
NEO4J_CONNECTION_TIMEOUT=5000

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333       # Auto-detects Docker: http://qdrant:6333
QDRANT_COLLECTION_NAME=knowledge_embeddings
QDRANT_VECTOR_DIM=768                  # TEI CPU model (all-mpnet-base-v2) = 768; GPU model = 1024; OpenAI ada-002 = 1536
KNOWLEDGE_CLUSTER_MIN_SIZE=3           # Minimum vectors to form a constellation cluster
KNOWLEDGE_CLUSTER_SIMILARITY=0.65      # Cosine similarity threshold for clustering (0.0-1.0)

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://:uaip_redis_password@localhost:6379
# OR configure individually:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=uaip_redis_password
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100
REDIS_OFFLINE_QUEUE=true

# =============================================================================
# BULLMQ ON REDIS STREAMS (replaces RabbitMQ)
# =============================================================================
REDIS_STREAMS_ENABLED=true
BULLMQ_CONCURRENCY=10
BULLMQ_MAX_RETRIES=3
BULLMQ_TIMEOUT=30000
BULLMQ_DEFAULT_JOB_OPTIONS={"attempts":3,"backoff":{"type":"exponential","delay":1000}}

# =============================================================================
# =============================================================================
# OLLAMA (local LLM + embeddings) - replaces TEI
# =============================================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_RERANKING_MODEL=nomic-reranker-text
OLLAMA_CHAT_MODEL=llama-3.1-70b-instruct-q4_K_M

# =============================================================================
# SERVICE PORTS & URLS
# =============================================================================
AGENT_INTELLIGENCE_PORT=3001
AGENT_INTELLIGENCE_URL=http://localhost:3001

ORCHESTRATION_PIPELINE_PORT=3002
ORCHESTRATION_PIPELINE_URL=http://localhost:3002

CAPABILITY_REGISTRY_PORT=3003
CAPABILITY_REGISTRY_URL=http://localhost:3003

SECURITY_GATEWAY_PORT=3004
SECURITY_GATEWAY_URL=http://localhost:3004

DISCUSSION_ORCHESTRATION_PORT=3005
DISCUSSION_ORCHESTRATION_URL=http://localhost:3005

ARTIFACT_SERVICE_PORT=3006
ARTIFACT_SERVICE_URL=http://localhost:3006

LLM_SERVICE_PORT=3007
LLM_SERVICE_URL=http://localhost:3007

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info                         # error | warn | info | debug | trace
DETAILED_LOGGING=false                # true for verbose logging

# =============================================================================
# EXECUTION & PERFORMANCE SETTINGS
# =============================================================================
OPERATION_TIMEOUT_MAX=3600000         # 1 hour in milliseconds
STEP_TIMEOUT_MAX=300000               # 5 minutes in milliseconds
MAX_CONCURRENT_OPERATIONS=10
MAX_RETRY_ATTEMPTS=3
# Maximum concurrent task DAGs in memory (OOM guard for TaskDAGService)
# Default: 100. Set higher for production with more memory.
MAX_CONCURRENT_DAGS=100
CLEANUP_INTERVAL=300000               # 5 minutes
CHECKPOINT_INTERVAL=60000             # 1 minute
RESOURCE_MONITORING_INTERVAL=10000    # 10 seconds

# =============================================================================
# STATE MANAGEMENT
# =============================================================================
STATE_COMPRESSION=false
MAX_CHECKPOINT_SIZE=10485760          # 10MB
CHECKPOINT_RETENTION_DAYS=7
STATE_CACHE_TIMEOUT=3600              # 1 hour

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000           # 15 minutes
RATE_LIMIT_MAX=100
RATE_LIMIT_STANDARD_HEADERS=true
RATE_LIMIT_LEGACY_HEADERS=false

# =============================================================================
# MONITORING & METRICS
# =============================================================================
METRICS_ENABLED=true

# OpenTelemetry (SignOZ)
OTEL_ENABLED=true                                           # Enable/disable OTel tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318           # OTLP HTTP endpoint (SignOZ collector)

# Sentry Error Tracking
SENTRY_ENABLED=true                                         # Enable/disable Sentry
SENTRY_DSN=                                                 # Optional fallback backend Sentry DSN
SENTRY_DSN_NAVRATNA_CORE=                                   # navratna-core Sentry project DSN
SENTRY_DSN_NAVRATNA_GATEWAY=                                # navratna-gateway Sentry project DSN
SENTRY_SECRET_KEY=uaip-sentry-dev-secret-key-change-in-prod # Sentry self-hosted secret key
VITE_SENTRY_DSN=                                            # Frontend Sentry project DSN
VITE_SENTRY_ENABLE=false                                    # Set true to capture in local/dev builds; production captures when DSN is set

# =============================================================================
# OIE (Operational Intelligence Engine) — PM-176
# =============================================================================

# SigNoz API (for OIE Collector programmatic queries)
SIGNOZ_API_URL=http://localhost:8080                        # SigNoz query-service HTTP API
SIGNOZ_API_KEY=                                             # SigNoz API key (Settings → API Keys in SigNoz UI)

# Sentry API (for OIE Collector programmatic queries)
SENTRY_API_URL=http://localhost:9000                        # Sentry self-hosted API base URL
SENTRY_AUTH_TOKEN=                                          # Sentry auth token (Settings → API → Auth Tokens)
SENTRY_ORG=sentry                                           # Sentry organization slug
SENTRY_PROJECT=navratna                                     # Sentry project slug

# OIE Feature Toggle
FEATURE_OIE=false                                           # Enable OIE feature module (default off; set true when SignOZ + Sentry running)
FEATURE_OIE_AUTONOMY=false                                  # Enable stubbed analyst/fixproposer/verifier/learner tier (default off; they return confidence 0.0 and share AutoJira's queue — leave off)

# OIE Collector
OIE_POLL_INTERVAL_MS=60000                                  # How often to poll observability sources (default 60s)
OIE_LOOKBACK_MINUTES=5                                      # How far back each poll looks (default 5min)

# OIE Triage
OIE_ERROR_DEDUP_COOLDOWN_MS=30000                           # Dedup window for identical errors (default 30s)
OIE_SEVERITY_ESCALATION_1H=10                               # Occurrences in 1h to escalate to medium
OIE_SEVERITY_ESCALATION_24H=50                              # Occurrences in 24h to escalate to high

# OIE Fix Proposer
OIE_CONFIDENCE_THRESHOLD=0.8                                # Auto-PR confidence gate (default 0.8)

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true

# =============================================================================
# JWT & AUTHENTICATION
# =============================================================================
JWT_SECRET=uaip_dev_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=uaip-security-gateway
JWT_AUDIENCE=uaip-services
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_SECRET=uaip_dev_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_TOKEN_EXPIRY=7d

# RS256 access tokens (asymmetric — the edge + federated subdomains verify via the
# published JWKS at /.well-known/jwks.json without a shared secret).
# In dev an in-memory keypair is auto-generated when JWT_PRIVATE_KEY is unset.
# In prod set a PKCS8 PEM private key (openssl genpkey -algorithm RSA ... -out key.pem).
JWT_PRIVATE_KEY=                                            # PKCS8 PEM (RS256 signing key); empty = dev auto-generate
JWT_KEY_ID=                                                 # optional stable kid; defaults to JWK thumbprint
JWT_RS256_EXPIRY=15m                                        # access-token TTL for RS256 path
# Set to HS256 to force legacy symmetric access tokens (rollback escape hatch).
AUTH_ACCESS_TOKEN_ALG=RS256

# GDPR erasure certificate HMAC salt — generate with: openssl rand -hex 32
DELETION_HASH_SALT=uaip_dev_deletion_hash_salt_change_in_production

# Service-to-service authentication token (required for agent-intelligence → orchestration-pipeline calls)
# Generate via POST /api/v1/auth/internal-token with a valid service API key
INTERNAL_SERVICE_TOKEN=

# Federation SSO - set to .tardis.digital so the httpOnly session cookie is valid
# across the UI (navratna.tardis.digital) and the API edge (api.navratna.tardis.digital).
# Leave empty for localhost dev.
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# =============================================================================
# EDGE / MESH / EXEC-WORKER
# =============================================================================
# Shared secret proving a request came through the Cloudflare Worker. When set,
# the Fly backends only trust X-User-* identity headers on requests carrying a
# matching X-Edge-Auth. MUST be identical on the Worker and both Fly apps. In
# production, if this is UNSET the backends fail closed (refuse forwarded identity).
EDGE_AUTH_SECRET=

# Exec worker (edge tool tier) — set to enable the worker runtime in the scheduler
FEATURE_EXEC_MESH=false
EXEC_WORKER_URL=                                            # https://exec.navratna.tardis.digital when deployed
EXEC_WORKER_SECRET=                                         # matches the worker's EXEC_WORKER_SECRET

# GitHub webhook receiver (orchestration-pipeline CI monitor). When set, the
# /api/v1/webhooks/github route is mounted and enforces HMAC-SHA256 signatures.
GITHUB_WEBHOOK_SECRET=

# =============================================================================
# OAUTH INTEGRATION PROVIDERS — security-gateway
# OAuthProviderSeed runs on every security-gateway boot and upserts one
# oauth_providers row per provider whose *_CLIENT_ID is set below. A provider
# with no CLIENT_ID is skipped entirely and will not appear in the Integrations
# UI, so set both values for each integration you want connectable.
# Redirect/callback URI to register with each provider:
#   {API_BASE_URL}/api/v1/oauth/callback
# ENCRYPTION_KEY (above) must be set — client secrets are AES-256-GCM encrypted
# at rest and cannot be sealed without it.
# =============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Jira and Confluence are one Atlassian OAuth 2.0 (3LO) app. You may reuse the
# same credentials for both; they differ only in requested scopes.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# =============================================================================
# CODING TIER (Fly-machine coding sessions) — capability-registry
# All of the following are REQUIRED for the coding tier to initialize. If ANY is
# missing the coding tier is DISABLED (its /api/v1/workspaces + GitHub App routes
# are not mounted) and the rest of the gateway serves normally.
# =============================================================================
# Node<->gateway session JWT signing keypair (RS256/EdDSA PEM). Generate a keypair;
# private stays on the gateway, public is handed to coding nodes.
CODING_NODE_JWT_PRIVATE_KEY_PEM=
CODING_NODE_JWT_PUBLIC_KEY_PEM=
# GitHub App used to broker per-installation, repo-scoped short-lived tokens
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
# 32-byte AES-256 key as exactly 64 hex chars (openssl rand -hex 32) to encrypt
# installation access tokens at rest in Redis
GITHUB_IAT_ENCRYPTION_KEY=
# Fly Machines API for provisioning coding microVMs
FLY_API_TOKEN=
FLY_CODING_APP=                                             # Fly app hosting coding machines
FLY_CODING_IMAGE=                                           # coding-node image ref
FLY_CODING_PRIMARY_REGION=                                  # e.g. sin
FLY_CODING_FALLBACK_REGIONS=                                # optional, comma-separated

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@uaip.dev

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_RESET_PASSWORD_PATH=/reset-password
FRONTEND_VERIFY_EMAIL_PATH=/verify-email

# Frontend Development (Vite)
VITE_API_URL=http://localhost:8081
VITE_API_TARGET=http://api-gateway:80
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# =============================================================================
# NOTIFICATIONS
# =============================================================================
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_EMAIL=true
NOTIFICATIONS_PUSH=false
NOTIFICATIONS_SMS=false
NOTIFICATIONS_RETRY_ATTEMPTS=3
NOTIFICATIONS_RETRY_DELAY=5000
NOTIFICATIONS_WEBHOOK_URL=
NOTIFICATIONS_WEBHOOK_SECRET=
NOTIFICATIONS_SMS_PROVIDER=
# Enables the `whatsapp` channel. Maps to config.notifications.whatsapp.enabled
# (not the channels.* flags above). Only "true" enables it. The gateway then
# publishes notification.whatsapp.send; navratna-core's Baileys client delivers.
NOTIFICATIONS_WHATSAPP_ENABLED=false

# =============================================================================
# LLM PROVIDERS
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_STUDIO_URL=http://localhost:1234
LLM_PROVIDER_ENCRYPTION_KEY=default-key-change-in-production

# =============================================================================
# R2/S3 DIRECT STORAGE (replaces MinIO)
# =============================================================================
S3_PROVIDER=cloudflare
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=navratna-artifacts
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=navratna-artifacts
R2_PUBLIC_URL=

# =============================================================================
# TAILSACLE NETWORK
# =============================================================================
TAILSCALE_HOSTNAME=pc-a-navratna
TAILSCALE_AUTH_KEY=
TAILSCALE_CONTROL_URL=https://login.tailscale.com

# =============================================================================
# OPENSHELL (sandboxed execution)
# =============================================================================
OPENSHELL_ENABLED=true
OPENSHELL_GATEWAY_URL=http://localhost:8080
OPENSHELL_POLICY_DIR=/data/navratna/policies

# MCP HTTP transport secrets
# Generate with: openssl rand -hex 32
# Only capability-registry decrypts this — never share across services
MCP_SECRETS_KEY=
# Per-provider API keys referenced via ${VAR} in MCP server httpHeaders
ZAI_API_KEY=

# =============================================================================
# CAPABILITY REGISTRY SPECIFIC
# =============================================================================
TOOL_EXECUTION_TIMEOUT=30000          # 30 seconds
MAX_CONCURRENT_EXECUTIONS=10
ENABLE_APPROVAL_WORKFLOW=false
DEFAULT_COST_LIMIT=100.0

# =============================================================================
# DISCUSSION ORCHESTRATION SPECIFIC
# =============================================================================
WEBSOCKET_ENABLED=true

# =============================================================================
# WHATSAPP (Baileys) — navratna-core only
# =============================================================================
# Agent an unbound contact is routed to before picking from the !agents menu.
WHATSAPP_DEFAULT_AGENT_ID=
# Redis logical DB for WhatsApp session/auth state (falls back to REDIS_DB, 0).
REDIS_WA_DB=0

# =============================================================================
# HUMAN-IN-THE-LOOP APPROVALS
# =============================================================================
# Approvers notified when an `approval` step suspends an operation.
# Comma-separated user ids. Empty ⇒ fails closed (rejected, never approved).
APPROVAL_DEFAULT_APPROVERS=
# jid:userId pairs, comma-separated — the ONLY identities allowed to approve by
# replying over WhatsApp. Read by BOTH navratna-core (jid → userId, to check an
# inbound reply) and navratna-gateway (userId → jid, to address the outbound
# prompt). Deliberately NOT the self-service `whatsapp:binding:*` chat binding.
# Empty ⇒ nobody can approve over WhatsApp.
# Example: WHATSAPP_APPROVER_ALLOWLIST=919812345678@s.whatsapp.net:user-abc
WHATSAPP_APPROVER_ALLOWLIST=

# =============================================================================
# TIMEOUT SETTINGS
# =============================================================================
API_TIMEOUT=30000
EXTERNAL_TIMEOUT=60000

# =============================================================================
# DOCKER & CONTAINERIZATION
# =============================================================================
DOCKER_ENV=false                      # Set to true in Docker environments
KUBERNETES_SERVICE_HOST=              # Auto-set in Kubernetes
HOSTNAME=                             # Auto-set by Docker

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================
DEBUG=false
VERBOSE_ERRORS=false

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
RATE_LIMIT_ENABLED=true
HELMET_ENABLED=true
COMPRESSION_ENABLED=true

# =============================================================================
# MIGRATION SETTINGS
# =============================================================================
RUN_MIGRATIONS=true                   # false in development
MIGRATION_TIMEOUT=60000

# =============================================================================
# PROMETHEUS METRICS
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_PASSWORD=admin

# =============================================================================
# HEALTH CHECK SETTINGS
# =============================================================================
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# =============================================================================
# VOLUME MOUNT PATHS (for Docker)
# =============================================================================
POSTGRES_DATA_PATH=postgres_data
NEO4J_DATA_PATH=neo4j_data
REDIS_DATA_PATH=redis_data
QDRANT_DATA_PATH=qdrant_data

# =============================================================================
# EXAMPLES OF ADVANCED CONFIGURATIONS
# =============================================================================

# Custom Database Pool Settings
# DB_POOL_MIN=2
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT=30000

# Custom Redis Cluster Configuration
# REDIS_CLUSTER_NODES=localhost:6379,localhost:6380,localhost:6381
# REDIS_CLUSTER_ENABLED=false

# Advanced Neo4j Settings
# NEO4J_BOLT_ROUTING=false
# NEO4J_ENCRYPTED=false
# NEO4J_TRUST_STRATEGY=TRUST_ALL_CERTIFICATES

# Advanced Security Settings
# BCRYPT_ROUNDS=12
# SESSION_SECRET=your-session-secret
# CSRF_SECRET=your-csrf-secret

# Custom Service Discovery
# CONSUL_URL=http://localhost:8500
# EUREKA_URL=http://localhost:8761

# =============================================================================
# NOTES
# =============================================================================
# 1. Values with 'localhost' will auto-detect Docker environment and switch to service names
# 2. Passwords and secrets should be changed in production
# 3. Boolean values: true/false (case sensitive)
# 4. Timeouts are in milliseconds unless specified otherwise
# 5. URLs should include protocol (http:// or https://)
# 6. Arrays are comma-separated (no spaces after commas)
# 7. Empty values will use defaults defined in config files
# ============================================================================= 
